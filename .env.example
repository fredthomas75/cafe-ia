# Stripe — clés depuis https://dashboard.stripe.com/apikeys
# Sans STRIPE_SECRET_KEY, la boutique tourne en mode démo
# (le checkout simule un paiement et confirme la commande).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL publique du site — utilisée pour les redirections Stripe success/cancel.
# Sur Vercel, laissée vide elle est dérivée automatiquement de VERCEL_URL.
# En local, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
